rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if
        request.resource.data.keys().hasOnly(['name', 'country', 'rating', 'text', 'recommend', 'createdAt']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60 &&
        request.resource.data.country is string &&
        request.resource.data.country.size() > 0 && request.resource.data.country.size() <= 40 &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500 &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        request.resource.data.recommend in ['yes', 'no'] &&
        request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }
  }
}
